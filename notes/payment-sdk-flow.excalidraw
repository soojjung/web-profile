  {
   "id": "el44",
   "type": "text",
   "x": 10,
   "y": 760,
   "width": 834.3999999999999,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
